---
import Base from '../../layouts/Base.astro';
import { base } from '../../lib/ui';

// Entraînements de la rubrique. D'autres formats pourront s'ajouter ici.
const entrees = [
  {
    id: 'cours',
    icone: '📘',
    titre: 'Quiz du cours',
    href: `${base}/quiz/cours/`,
    description:
      "Questions tirées de vos fiches, filtrables par matière et par fiche. " +
      'Correction immédiate après chaque réponse, score en fin de série.',
  },
];
---

<Base titre="Quiz" actif="quiz">
  <h1 class="mb-1 text-2xl font-bold text-slate-900 dark:text-white">Quiz</h1>
  <p class="mb-8 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
    Se tester sur ses fiches, question après question, avec correction
    immédiate.
  </p>

  <div class="grid gap-4 sm:grid-cols-2">
    {
      entrees.map((entree) => (
        <a
          href={entree.href}
          class="group flex flex-col rounded-xl border border-slate-200 bg-white px-5 py-5 transition hover:border-indigo-400 hover:bg-indigo-50/50 dark:border-slate-700 dark:bg-slate-900 dark:hover:border-indigo-600 dark:hover:bg-indigo-950/30"
        >
          <span class="text-3xl" aria-hidden="true">
            {entree.icone}
          </span>
          <span class="mt-3 font-semibold text-slate-900 dark:text-white">{entree.titre}</span>
          <span class="mt-1 flex-1 text-sm text-slate-500 dark:text-slate-400">
            {entree.description}
          </span>
          <span
            id={`compte-${entree.id}`}
            class="etiquette mt-3 block text-indigo-600 dark:text-indigo-400"
          />
          <span class="mt-3 text-sm font-medium text-indigo-600 dark:text-indigo-400">
            Commencer <span aria-hidden="true">→</span>
          </span>
        </a>
      ))
    }
  </div>

  <div id="historique-quiz" class="mt-10"></div>
</Base>

<script>
  import { auDeverrouillage } from '../../lib/chargement';
  import { chargerManifeste } from '../../lib/contenu';
  import { tousLesResultatsQuiz } from '../../lib/db';
  import { echapper, formaterDate, lien, pluriel } from '../../lib/ui';

  const $ = (id: string) => document.getElementById(id)!;

  /**
   * Les anciens liens visaient « /quiz/ » avec le périmètre en paramètre : ils
   * doivent aboutir au quiz du cours, désormais une page à part.
   */
  function rediriger(): boolean {
    const parametres = new URLSearchParams(location.search);
    if (!parametres.has('fiche') && !parametres.has('fiches')) return false;
    location.replace(`${lien('/quiz/cours/')}?${parametres}`);
    return true;
  }

  /** Les cinq derniers passages, quelle que soit leur nature. */
  async function afficherHistorique() {
    const series = (await tousLesResultatsQuiz()).map((r) => ({
      le: r.le,
      libelle: r.matiere,
      detail: `${r.bonnes}/${r.total}`,
      reussi: r.total > 0 && r.bonnes / r.total >= 0.8,
      href: lien('/quiz/cours/'),
    }));
    const tout = [...series]
      .sort((a, b) => b.le.localeCompare(a.le))
      .slice(0, 5);
    const zone = $('historique-quiz');
    zone.innerHTML = '';
    if (!tout.length) return;

    const titre = document.createElement('h2');
    titre.className = 'mb-3 text-lg font-semibold text-slate-900 dark:text-white';
    titre.textContent = 'Derniers passages';
    zone.appendChild(titre);

    const liste = document.createElement('div');
    liste.className = 'space-y-2';
    for (const ligne of tout) {
      const carte = document.createElement('a');
      carte.href = ligne.href;
      carte.className =
        'flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm transition hover:border-indigo-400 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-600';
      carte.innerHTML =
        `<span class="min-w-0 flex-1 truncate text-slate-700 dark:text-slate-200">${echapper(ligne.libelle)}</span>` +
        `<span class="shrink-0 text-xs text-slate-400">${formaterDate(ligne.le)}</span>` +
        `<span class="shrink-0 font-semibold tabular-nums ${ligne.reussi ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-400'}">${ligne.detail}</span>`;
      liste.appendChild(carte);
    }
    zone.appendChild(liste);
  }

  auDeverrouillage(async () => {
    if (rediriger()) return;

    const manifeste = await chargerManifeste();
    $('compte-cours').textContent = `${pluriel(manifeste.totaux.quiz, 'question')} en banque`;

    await afficherHistorique();
  });
</script>
